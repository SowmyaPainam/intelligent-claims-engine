{
  "name": "intelligent-claims-engine",
  "version": "1.0.0",
  "description": "Intelligent Enterprise Claims & Budget Governance Engine",
  "main": "srv/server.js",
  "scripts": {
    "start": "cds run",
    "dev": "cds watch",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "test": "jest",
    "watch-claimsdashboard": "cds watch --open com.company.claimsdashboard/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy intelligent-claims-engine --delete-services --delete-service-keys --delete-service-brokers",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "watch-approvalqueue": "cds watch --open approvalqueue/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-budgetstatus": "cds watch --open budgetstatus/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-auditviewer": "cds watch --open auditviewer/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "dependencies": {
    "@sap/cds": "^10.1.0",
    "axios": "^1.4.0",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "multer": "^2.4.0",
    "uuid": "^9.0.0"
  },
  "jest": {
  "testPathIgnorePatterns": ["/node_modules/", "/app/"]
},
  "devDependencies": {
    "@cap-js/sqlite": "^3.1.1",
    "@sap/cds-dk": "^10.1.0",
    "cds-plugin-ui5": "^0.17.0",
    "chai": "^4.3.0",
    "jest": "^29.0.0",
    "mbt": "^1.2.49",
    "mocha": "^10.0.0",
    "rimraf": "^5.0.5",
    "sqlite3": "^6.0.1"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/claimsdashboard",
    "app/approvalqueue",
    "app/budgetstatus",
    "app/budgetstatus",
    "app/auditviewer"
  ],
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": ":memory:"
        }
      }
    }
  }

}
