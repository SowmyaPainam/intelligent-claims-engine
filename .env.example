# SAP BTP Configuration
BTP_ACCOUNT_ID=your_account_id
BTP_USERNAME=your_username
BTP_PASSWORD=your_password

# HANA Cloud Configuration
HANA_HOST=your_hana_host
HANA_PORT=443
HANA_USER=your_hana_user
HANA_PASSWORD=your_hana_password

# Document AI (DIE)
DIE_API_URL=https://api.sap.com/document-extraction
DIE_API_KEY=your_api_key
DIE_MODEL_ID=claims_extraction

# Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Application Settings
NODE_ENV=development
LOG_LEVEL=info
PORT=4004
DEBUG=false