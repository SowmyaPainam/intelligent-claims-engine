{
  "name": "intelligent-claims-engine",
  "version": "1.0.0",
  "description": "Intelligent Enterprise Claims & Budget Governance Engine",
  "main": "srv/server.js",
  "scripts": {
    "start": "cds run",
    "dev": "cds watch",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "test": "jest",
    "watch-claimsdashboard": "cds watch --open com.company.claimsdashboard/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy intelligent-claims-engine --delete-services --delete-service-keys --delete-service-brokers",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "dependencies": {
    "@sap/cds": "^7.0.0",
    "axios": "^1.4.0",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@sap/cds-dk": "^8.9.19",
    "chai": "^4.3.0",
    "jest": "^29.0.0",
    "mocha": "^10.0.0",
    "sqlite3": "^6.0.1",
    "cds-plugin-ui5": "^0.17.0",
    "rimraf": "^5.0.5",
    "mbt": "^1.2.49"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/claimsdashboard"
  ]
}
